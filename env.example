# Copy to .env (do NOT commit .env), then create the K8s secret from it:
#   kubectl create secret generic etl-secrets --from-env-file=.env

BACKEND_LOG_ENDPOINT=https://your-backend.example.com
BACKEND_API_KEY=replace-me
FEATURE_DB_URL=postgresql://user:pass@host:5432/dbname

# Optional: ship the trained artifacts with ETL (no MLflow server needed).
# Copy these files into the folder you point to:
#   - kmeans_model.pkl
#   - scaler.pkl
#   - role_mapping.json
#   - feature_names.json
# Example (inside container): /app/models/team_role_model
TEAM_ROLE_ARTIFACT_DIR=

